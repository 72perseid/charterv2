# Copy to deploy/.env and fill in. Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'

SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me

# Hostnames Django will answer for, comma separated. Include the public name on the VPS.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to make state-changing requests. Include https://<public name> on the VPS.
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Where the compose Caddy is published on the host. Reviewers: leave as is and open
# http://localhost:8080. VPS: leave as is and let the host Caddy proxy to it.
CADDY_BIND=127.0.0.1:8080

# true when the public origin is https (cookies are then marked Secure).
SECURE_COOKIES=false

# Optional. When set together with REQUIRE_EMAIL_VERIFICATION=true, registration
# requires a verified email. smtp://user:password@host:587?tls=true
EMAIL_URL=
REQUIRE_EMAIL_VERIFICATION=false

DEBUG=false
