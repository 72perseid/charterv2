# Copy to deploy/.env and fill in. Generate secrets with:
#   python3 -c 'import secrets; print(secrets.token_urlsafe(50))'

SECRET_KEY=change-me
POSTGRES_PASSWORD=change-me
# Encrypts users' model API keys at rest. Generate with:
#   python3 -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Losing it means every stored key must be re-entered.
FERNET_KEY=change-me

# Hostnames Django will answer for, comma separated. Include the public name on the VPS.
ALLOWED_HOSTS=localhost,127.0.0.1
# Origins allowed to make state-changing requests. Include https://<public name> on the VPS.
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Where the compose Caddy is published on the host. Reviewers: leave as is and open
# http://localhost:8080. VPS: leave as is and let the host Caddy proxy to it.
CADDY_BIND=127.0.0.1:8080

# true when the public origin is https (cookies are then marked Secure).
SECURE_COOKIES=false

# Optional. When set together with REQUIRE_EMAIL_VERIFICATION=true, registration
# requires a verified email. smtp://user:password@host:587?tls=true
EMAIL_URL=
REQUIRE_EMAIL_VERIFICATION=false

# Users point Chart-er at any OpenAI-compatible endpoint. By default the server
# refuses http:// and private/loopback hosts, so one user cannot make it call
# services on this box. Set true only when you run a local model (Ollama, vLLM)
# on a machine you trust every user of. The API key may then be left blank, and
# the base URL for a model server on this host is
#   http://host.docker.internal:11434/v1      (Ollama's default port)
# since localhost inside a container is the container itself. See README,
# "Running with a local model".
ALLOW_PRIVATE_ENDPOINTS=false

DEBUG=false
